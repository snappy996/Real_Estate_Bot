# Copy to .env and fill in. Never commit .env.

# Neon: Dashboard > Connect > pooled connection string (AWS Singapore project)
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

GEMINI_API_KEY=
GROQ_API_KEY=

LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIM=768

# Put a real contact in the user agent; site owners appreciate it.
SCRAPER_USER_AGENT=RealEstateResearchBot/0.1 (contact: you@example.com)
SCRAPER_DELAY_SECONDS=3
